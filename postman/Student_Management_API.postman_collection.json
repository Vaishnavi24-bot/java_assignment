          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"\",\n  \"email\": \"bad\",\n  \"course\": \"\",\n  \"age\": -1\n}"
        }
      }
    },
    {
      "name": "10. Duplicate email (409)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/students",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Dup\",\n  \"email\": \"simran@example.com\",\n  \"course\": \"BBA\",\n  \"age\": 20\n}"
        }
