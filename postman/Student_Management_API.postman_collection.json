{
  "info": {
    "name": "Student Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "1. Add student (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/students",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Aarav Sharma\",\n  \"email\": \"aarav@example.com\",\n  \"course\": \"Computer Science\",\n  \"age\": 20\n}"
        }
      }
    },
    {
      "name": "2. Add second student (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/students",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Simran Kaur\",\n  \"email\": \"simran@example.com\",\n  \"course\": \"Computer Science\",\n  \"age\": 22\n}"
        }
      }
    },
    {
      "name": "3. Get all students (200)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/students",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students"
          ]
        }
      }
    },
    {
      "name": "4. Get student by id (200)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/students/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students",
            "1"
          ]
        }
      }
    },
    {
      "name": "5. Update student (200)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/students/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students",
            "1"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Aarav S. Sharma\",\n  \"email\": \"aarav@example.com\",\n  \"course\": \"Data Science\",\n  \"age\": 21\n}"
        }
      }
    },
    {
      "name": "6. Get students by course (200)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/students/course/Computer Science",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students",
            "course",
            "Computer Science"
          ]
        }
      }
    },
    {
      "name": "7. Delete student (204)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/students/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students",
            "1"
          ]
        }
      }
    },
    {
      "name": "8. Get deleted student (404)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/students/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students",
            "1"
          ]
        }
      }
    },
    {
      "name": "9. Invalid body (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/students",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
